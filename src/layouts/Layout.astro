---
import '../styles/global.css';
import MobileActionBar from '../components/MobileActionBar.astro';

export interface Props {
  title?: string;
  description?: string;
  actionBar?: boolean;
}

const {
  title = 'Building Hope | Cassandra for Ward 6',
  description = 'Cassandra Echeverria is running for Alderperson of Ward 6 in Aurora, Illinois, on a simple idea: people should come before power. The primary is February 23, 2027.',
  actionBar = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(`${base}/images/og-card.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#782888" />

    <title>{title}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cassandra for Ward 6" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cassandra for Ward 6. Building Hope. Aurora, Illinois. Primary February 23, 2027. General April 6, 2027." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    {actionBar && <MobileActionBar />}

    <script>
      import { initI18n } from '../i18n/i18n.js';
      import { initMotion } from '../scripts/motion.js';
      document.addEventListener('DOMContentLoaded', () => {
        initI18n();
        initMotion();
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute; left: -999px; top: 8px; z-index: 10001;
    background: var(--pink); color: var(--white); padding: 8px 14px; border-radius: 999px; font-weight: 700;
  }
  .skip-link:focus { left: 8px; }
</style>
