---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const DONATE = 'https://secure.actblue.com/donate/cassandrabuildinghope';
---

<section class="hero" id="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="blob blob-a"></span>
    <span class="blob blob-b"></span>
    <span class="blob blob-c"></span>
    <img src={`${base}/flower.png`} alt="" class="hero-flower hero-flower-1" />
    <img src={`${base}/flower.png`} alt="" class="hero-flower hero-flower-2" />
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="hero-kicker animate-in" style="--reveal-delay: 0s" data-i18n="hero.kicker">Aurora, Illinois · Ward 6 · Primary February 23, 2027</span>

      <h1 class="hero-headline">
        <span class="animate-in" style="--reveal-delay: 0.1s" data-i18n="hero.headline_1">People should come</span>
        <span class="hero-headline-em animate-in" style="--reveal-delay: 0.2s" data-i18n="hero.headline_2">before power.</span>
      </h1>

      <p class="hero-sub animate-in" style="--reveal-delay: 0.3s" data-i18n="hero.sub">
        Cassandra Echeverria is running for Alderperson of Ward 6 with a simple idea: safer neighborhoods through accountability, dignity for every neighbor, and real investment in the people who make Aurora home.
      </p>

      <div class="hero-ctas animate-in" style="--reveal-delay: 0.4s">
        <a href={`${base}/volunteer#signup`} class="btn btn-pink btn-massive" data-i18n="hero.cta_volunteer">Join the team</a>
        <a href={DONATE} class="btn btn-outline" target="_blank" rel="noopener" data-i18n="hero.cta_donate">Chip in</a>
      </div>

      <p class="hero-people animate-in" style="--reveal-delay: 0.5s" data-i18n="hero.people">Powered by everyday people. Not corporations.</p>
    </div>

    <div class="hero-card animate-in" style="--reveal-delay: 0.35s">
      <div class="photo-frame">
        <div class="photo-placeholder">
          <img src={`${base}/flower.png`} alt="" class="photo-flower" aria-hidden="true" />
          <span class="placeholder-note" data-i18n="hero.photo_note">Photo coming soon</span>
        </div>
      </div>
      <div class="hero-card-foot">
        <span class="hero-card-name">Cassandra Echeverria</span>
        <span class="hero-card-role" data-i18n="hero.card_role">Candidate for Ward 6 Alderperson</span>
      </div>
      <div class="hero-countdown">
        <span class="countdown-num stat-tabular" data-days-until="2027-02-23">147</span>
        <span class="countdown-label" data-i18n="hero.countdown">days until the primary</span>
      </div>
    </div>
  </div>

  <a href="#promise" class="hero-scroll" aria-label="Scroll down">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </a>
</section>

<style>
  .hero {
    position: relative; min-height: 100svh;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-3xl);
    display: flex; align-items: center; overflow: hidden;
    background: linear-gradient(180deg, var(--cream) 0%, var(--lilac) 100%);
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.55; }
  .blob-a { width: 520px; height: 520px; background: var(--pink-light); top: -120px; right: -80px; }
  .blob-b { width: 420px; height: 420px; background: #e6d6ea; bottom: -160px; left: -120px; }
  .blob-c { width: 300px; height: 300px; background: var(--green-light); top: 45%; left: 42%; opacity: 0.5; }
  .hero-flower { position: absolute; opacity: 0.18; width: 180px; }
  .hero-flower-1 { top: 12%; left: -30px; transform: rotate(-18deg); }
  .hero-flower-2 { bottom: 8%; right: 6%; width: 130px; transform: rotate(12deg) scaleX(-1); }

  .hero-inner { position: relative; display: grid; grid-template-columns: 1.25fr 0.85fr; gap: var(--space-3xl); align-items: center; }
  .hero-kicker { display: inline-block; font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); margin-bottom: var(--space-lg); }
  .hero-headline { font-family: var(--font-display); font-weight: 700; font-size: var(--text-5xl); line-height: 0.98; color: var(--black); letter-spacing: -0.015em; display: flex; flex-direction: column; margin-bottom: var(--space-lg); }
  .hero-headline-em { color: var(--purple); font-style: italic; font-weight: 700; }
  .hero-sub { font-size: var(--text-lg); color: var(--gray-700); max-width: 560px; margin-bottom: var(--space-xl); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; margin-bottom: var(--space-lg); }
  .hero-people { font-family: var(--font-display); font-style: italic; color: var(--purple); font-size: var(--text-lg); }

  .hero-card { background: var(--white); border-radius: var(--radius-xl); padding: var(--space-md); box-shadow: var(--shadow-xl); transform: rotate(1.5deg); border: 1px solid rgba(120,40,136,0.08); }
  .photo-frame { border-radius: var(--radius-lg); overflow: hidden; background: var(--lilac); }
  .photo-placeholder { aspect-ratio: 4 / 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-md); border: 2px dashed rgba(120,40,136,0.35); border-radius: var(--radius-lg); background: linear-gradient(160deg, var(--lilac), var(--pink-light)); }
  .photo-flower { width: 42%; opacity: 0.85; }
  .hero-card-foot { display: flex; flex-direction: column; padding: var(--space-md) var(--space-sm) var(--space-sm); }
  .hero-card-name { font-family: var(--font-display); font-size: var(--text-xl); color: var(--purple); font-weight: 700; }
  .hero-card-role { font-size: var(--text-sm); color: var(--gray-500); }
  .hero-countdown { display: flex; align-items: baseline; gap: var(--space-sm); padding: var(--space-sm) var(--space-sm) var(--space-xs); border-top: 1px solid rgba(120,40,136,0.1); }
  .countdown-num { font-family: var(--font-display); font-size: var(--text-3xl); color: var(--pink-dark); font-weight: 700; line-height: 1; }
  .countdown-label { font-size: var(--text-sm); color: var(--gray-700); font-weight: 500; }

  .hero-scroll { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); color: var(--purple); opacity: 0.6; animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }

  @media (max-width: 900px) {
    .hero { min-height: auto; padding-bottom: var(--space-4xl); }
    .hero-inner { grid-template-columns: 1fr; gap: var(--space-2xl); }
    .hero-card { max-width: 380px; margin: 0 auto; transform: rotate(0); }
    .hero-scroll { display: none; }
    .hero-flower-1 { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-scroll { animation: none; } }
</style>
