---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const DONATE = 'https://secure.actblue.com/donate/cassandrabuildinghope';
---

<section class="join section-padding" id="join">
  <div class="container join-inner">
    <img src={`${base}/flower.png`} alt="" class="join-flower animate-in" aria-hidden="true" />
    <span class="section-label animate-in" data-i18n="home.join_label">Get involved</span>
    <h2 class="section-title animate-in" style="--reveal-delay: 0.1s" data-i18n="home.join_title">Hope gets built by hand. Bring yours.</h2>
    <p class="join-desc animate-in" style="--reveal-delay: 0.15s" data-i18n="home.join_desc">Knock a few doors. Host a house meeting. Put a sign in the yard. Chip in what you can. Every bit of it reaches another Ward 6 neighbor.</p>
    <div class="join-ctas animate-in" style="--reveal-delay: 0.2s">
      <a href={`${base}/volunteer#signup`} class="btn btn-pink btn-massive" data-i18n="home.join_cta">Join the team</a>
      <a href={DONATE} class="btn btn-outline" target="_blank" rel="noopener" data-i18n="home.join_donate">Donate on ActBlue</a>
    </div>
    <p class="join-email animate-in" style="--reveal-delay: 0.25s">
      <span data-i18n="home.join_email">Questions? Write to</span>
      <a href="mailto:auroraforcassandra@gmail.com">auroraforcassandra@gmail.com</a>
    </p>
  </div>
</section>

<style>
  .join { background: linear-gradient(180deg, var(--white), var(--pink-light)); text-align: center; }
  .join-inner { max-width: 720px; display: flex; flex-direction: column; align-items: center; }
  .join-flower { width: 84px; margin-bottom: var(--space-md); }
  .join-desc { color: var(--gray-700); margin-bottom: var(--space-xl); }
  .join-ctas { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; }
  .join-email { margin-top: var(--space-xl); font-size: var(--text-sm); color: var(--gray-500); }
  .join-email a { color: var(--purple); font-weight: 600; margin-left: 4px; }
  .join-email a:hover { text-decoration: underline; }
</style>
