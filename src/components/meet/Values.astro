---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const vals = [
  { k: '1', title: 'Safety, with accountability', text: 'Everyone in Ward 6 deserves to feel safe. That means public safety that is centered on the community and answers to it.' },
  { k: '2', title: 'Dignity for every neighbor', text: 'Unhoused neighbors and struggling families are people, not problems to move out of sight. They deserve practical help and respect.' },
  { k: '3', title: 'Investment in our future', text: 'Our neighborhoods, our young people and the services that help families thrive are worth investing in, starting now.' },
];
---

<section class="values section-padding" id="values">
  <div class="container">
    <div class="head">
      <span class="section-label animate-in" data-i18n="meet.values_label">What she stands for</span>
      <h2 class="section-title animate-in" data-i18n="meet.values_title">Three values, three promises</h2>
    </div>
    <div class="grid">
      {vals.map((v, i) => (
        <div class="val animate-in" style={`--reveal-delay:${i * 0.1}s`}>
          <img src={`${base}/flower.png`} alt="" aria-hidden="true" />
          <h3 data-i18n={`meet.values_${v.k}_title`}>{v.title}</h3>
          <p data-i18n={`meet.values_${v.k}_text`}>{v.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .values { background: var(--cream); }
  .head { margin-bottom: var(--space-2xl); }
  .grid { display: grid; gap: var(--space-xl); grid-template-columns: 1fr; }
  .val { border-top: 3px solid var(--green); padding-top: var(--space-lg); }
  .val img { width: 32px; margin-bottom: var(--space-md); }
  h3 { font-size: var(--text-xl); margin-bottom: var(--space-sm); }
  .val p { color: var(--gray-700); }
  @media (min-width: 800px) { .grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-2xl); } }
</style>
