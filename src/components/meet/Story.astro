---
const cards = [
  { k: 'roots', n: '01' },
  { k: 'work', n: '02' },
  { k: 'family', n: '03' },
  { k: 'community', n: '04' },
];
const en = {
  roots: ["A neighbor, not a politician", "Cassandra lives in Ward 6 and is running to represent the people she sees every day. She chose this race because this is where her neighbors are."],
  work: ["Listening first", "Cassandra is not asking for the seat because of a title. She is asking for it to do the work: show up, hear people out, and bring what she hears to City Hall."],
  family: ["Why it is personal", "The schools, the streets, the services families depend on. Those are the things that make a ward feel like home, and they are why Cassandra decided to run."],
  community: ["Showing up for neighbors", "This campaign is built the way Cassandra wants to serve: one conversation at a time, with neighbors who believe Ward 6 deserves a real choice."],
};
---

<section class="story section-padding" id="story">
  <div class="container">
    <div class="head">
      <span class="section-label animate-in" data-i18n="meet.story_label">Her story</span>
      <h2 class="section-title animate-in" data-i18n="meet.story_title">The person behind the campaign</h2>
      <p class="lead animate-in" data-i18n="meet.story_intro">Cassandra is a Ward 6 neighbor who decided that waiting for someone else to run was not good enough. Here is what she is about.</p>
    </div>
    <div class="grid">
      {cards.map((c, i) => (
        <article class="card animate-in" style={`--reveal-delay:${i * 0.08}s`}>
          <span class="num">{c.n}</span>
          <h3 data-i18n={`meet.story_${c.k}_title`}>{en[c.k][0]}</h3>
          <p data-i18n={`meet.story_${c.k}_text`}>{en[c.k][1]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .story { background: var(--cream-dark); }
  .head { max-width: 44rem; margin-bottom: var(--space-2xl); }
  .grid { display: grid; gap: var(--space-lg); grid-template-columns: 1fr; }
  .card { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
  .num { font-family: var(--font-display); font-size: var(--text-2xl); color: var(--pink-dark); font-weight: 700; }
  h3 { font-size: var(--text-xl); }
  .card p { color: var(--gray-700); margin-bottom: var(--space-sm); }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
