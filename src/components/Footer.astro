---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const DONATE = 'https://secure.actblue.com/donate/cassandrabuildinghope';
// TODO: real social handles. Placeholders point to "#".
const socials = [
  { name: 'Instagram', href: '#', icon: 'ig' },
  { name: 'Facebook', href: '#', icon: 'fb' },
  { name: 'TikTok', href: '#', icon: 'tt' },
];
---

<footer class="site-footer on-dark" id="footer">
  <div class="footer-band">
    <div class="container band-inner">
      <div class="band-text">
        <span class="band-label" data-i18n="footer.band_label">Powered by neighbors, not corporations</span>
        <span class="band-value" data-i18n="footer.band_text">Every dollar helps us reach more Ward 6 neighbors.</span>
      </div>
      <a href={DONATE} class="btn btn-pink" target="_blank" rel="noopener" data-i18n="nav.donate">Donate</a>
    </div>
  </div>

  <div class="footer-main">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img src={`${base}/logo.png`} alt="Cassandra for Ward 6. Building Hope." class="footer-logo" width="713" height="362" />
        <p class="footer-motto" data-i18n="footer.motto">People should come before power.</p>
        <a href="mailto:auroraforcassandra@gmail.com" class="footer-email">auroraforcassandra@gmail.com</a>
      </div>

      <div class="footer-links">
        <h4 data-i18n="footer.links_title">Explore</h4>
        <ul>
          <li><a href={`${base}/meet`} data-i18n="nav.meet">Meet Cassandra</a></li>
          <li><a href={`${base}/priorities`} data-i18n="nav.priorities">Priorities</a></li>
          <li><a href={`${base}/why-now`} data-i18n="nav.whynow">Why Now</a></li>
          <li><a href={`${base}/volunteer`} data-i18n="nav.volunteer">Get Involved</a></li>
          <li><a href={DONATE} target="_blank" rel="noopener" data-i18n="nav.donate">Donate</a></li>
        </ul>
      </div>

      <div class="footer-dates">
        <h4 data-i18n="footer.dates_title">Key dates</h4>
        <ul>
          <li><span class="date-when" data-i18n="footer.when_petitions">Oct 19 - 26, 2026</span><span data-i18n="footer.date_petitions">Petition filing with the City Clerk</span></li>
          <li><span class="date-when date-big" data-i18n="footer.when_primary">Feb 23, 2027</span><span data-i18n="footer.date_primary">Primary election day</span></li>
          <li><span class="date-when" data-i18n="footer.when_election">Apr 6, 2027</span><span data-i18n="footer.date_election">General election</span></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4 data-i18n="footer.follow_title">Follow</h4>
        <div class="social-icons">
          {socials.map((s) => (
            <a href={s.href} class="social-link" aria-label={s.name} target="_blank" rel="noopener" title={`${s.name} (link to confirm)`}>
              {s.icon === 'ig' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>}
              {s.icon === 'fb' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>}
              {s.icon === 'tt' && <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.23 8.23 0 0 0 4.76 1.51V6.82a4.83 4.83 0 0 1-1-.13z"/></svg>}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="container footer-legal">
      <p class="paid-for" data-i18n="footer.paid_for">Paid for by Friends of Cassandra Echeverria</p>
      <p class="disclosure" data-i18n="footer.disclosure">A copy of our report filed with the Illinois State Board of Elections is (or will be) available on the Board's official website (elections.il.gov) or for purchase from the State Board of Elections, Springfield, Illinois.</p>
      <p class="copyright" data-i18n="footer.copyright">© 2026 Cassandra for Ward 6. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--purple-deep); color: rgba(255,255,255,0.88); }
  .footer-band { background: var(--purple); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .band-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); padding: var(--space-lg) var(--space-lg); flex-wrap: wrap; }
  .band-text { display: flex; flex-direction: column; gap: 2px; }
  .band-label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--pink); }
  .band-value { font-family: var(--font-display); font-size: var(--text-xl); color: var(--white); }

  .footer-main { padding: var(--space-3xl) 0 var(--space-xl); }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1fr; gap: var(--space-2xl); }
  .footer-logo { width: 220px; height: auto; background: var(--cream); padding: 12px 16px; border-radius: var(--radius-md); }
  .footer-motto { margin-top: var(--space-md); font-family: var(--font-display); font-style: italic; font-size: var(--text-lg); color: var(--white); }
  .footer-email { display: inline-block; margin-top: var(--space-sm); color: var(--pink); font-weight: 600; font-size: var(--text-sm); }
  .footer-email:hover { text-decoration: underline; }
  h4 { font-family: var(--font-body); font-size: var(--text-xs); letter-spacing: 0.2em; text-transform: uppercase; color: var(--pink); margin-bottom: var(--space-md); font-weight: 700; }
  .footer-links li { margin-bottom: var(--space-sm); }
  .footer-links a { color: var(--white); font-weight: 500; transition: color var(--duration-fast); }
  .footer-links a:hover { color: var(--pink); }
  .footer-dates li { display: flex; flex-direction: column; margin-bottom: var(--space-md); font-size: var(--text-sm); }
  .date-when { font-weight: 700; color: var(--white); font-variant-numeric: tabular-nums; }
  .date-big { font-family: var(--font-display); font-size: var(--text-xl); color: var(--pink); }
  .social-icons { display: flex; gap: var(--space-sm); }
  .social-link { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: rgba(255,255,255,0.1); color: var(--white); transition: all var(--duration-fast); }
  .social-link:hover { background: var(--pink); transform: translateY(-2px); }
  .social-note { margin-top: var(--space-sm); }

  .footer-legal { margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid rgba(255,255,255,0.12); text-align: center; }
  .paid-for { font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: var(--text-xs); color: var(--white); border: 1px solid rgba(255,255,255,0.3); display: inline-block; padding: 4px 12px; border-radius: 4px; }
  .disclosure { font-size: 0.72rem; color: rgba(255,255,255,0.6); max-width: 720px; margin: var(--space-md) auto; line-height: 1.5; }
  .copyright { font-size: 0.72rem; color: rgba(255,255,255,0.5); }

  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: var(--space-xl); } .band-inner { justify-content: center; text-align: center; } .band-text { align-items: center; } }
</style>
