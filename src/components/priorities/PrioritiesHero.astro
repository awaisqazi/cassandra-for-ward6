---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="p-hero">
  <img class="orn" src={`${base}/flower.png`} alt="" aria-hidden="true" />
  <div class="container inner">
    <span class="section-label animate-in" data-i18n="priorities.hero_label">Our priorities</span>
    <h1 class="animate-in" data-i18n="priorities.hero_headline">People before power, on every block of Ward 6.</h1>
    <p class="lead animate-in" data-i18n="priorities.hero_sub">Three commitments, in plain words. Cassandra has no voting record yet, so instead of boasting she is promising, and she wants you to hold her to it.</p>
  </div>
</section>

<style>
  .p-hero {
    position: relative; overflow: hidden;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-3xl);
    background: linear-gradient(160deg, var(--lilac) 0%, var(--cream) 100%);
  }
  .orn { position: absolute; right: -80px; top: 40px; width: 360px; max-width: 70vw; opacity: 0.1; pointer-events: none; }
  .inner { position: relative; max-width: 860px; }
  h1 { font-size: var(--text-5xl); line-height: 1.02; letter-spacing: -0.02em; margin-bottom: var(--space-lg); }
  .lead { max-width: 40rem; }
</style>
