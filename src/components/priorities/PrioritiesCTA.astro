---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cta section-padding on-dark" id="priorities-cta">
  <div class="container inner">
    <h2 class="animate-in" data-i18n="priorities.cta_title">Help build a Ward 6 that puts neighbors first.</h2>
    <p class="animate-in" data-i18n="priorities.cta_text">The primary is February 23, 2027. Volunteer, donate, or tell a neighbor. Every bit of it counts.</p>
    <div class="btns animate-in">
      <a class="btn btn-pink" href={`${base}/volunteer#signup`} data-i18n="priorities.cta_join">Join the team</a>
      <a class="btn btn-cream" href="https://secure.actblue.com/donate/cassandrabuildinghope" target="_blank" rel="noopener" data-i18n="priorities.cta_donate">Donate</a>
    </div>
  </div>
</section>

<style>
  .cta { background: linear-gradient(135deg, var(--purple-deep), var(--violet)); text-align: center; }
  .inner { display: flex; flex-direction: column; align-items: center; gap: var(--space-lg); max-width: 760px; }
  h2 { font-size: var(--text-3xl); }
  .btns { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; }
</style>
