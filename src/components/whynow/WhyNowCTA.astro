---
const DONATE = 'https://secure.actblue.com/donate/cassandrabuildinghope';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="section-padding cta">
  <div class="container cta-inner">
    <h2 class="section-title animate-in" data-i18n="whynow.cta.title">Ward 6 deserves a choice</h2>
    <p class="lead animate-in" data-i18n="whynow.cta.text">Neighbors make change happen. Give an hour, share a story, or chip in, and help build hope in Ward 6.</p>
    <div class="cta-btns animate-in">
      <a href={`${base}/volunteer#signup`} class="btn btn-purple btn-massive" data-i18n="whynow.cta.volunteer">Join the team</a>
      <a href={DONATE} class="btn btn-pink" target="_blank" rel="noopener" data-i18n="whynow.cta.donate">Donate</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--pink-light); text-align: center; }
  .cta-inner { max-width: 720px; }
  .cta-inner .section-title { font-size: var(--text-4xl); }
  .cta-btns { display: flex; flex-wrap: wrap; gap: var(--space-md); justify-content: center; margin-top: var(--space-xl); }
</style>
