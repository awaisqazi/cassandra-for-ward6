---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="pq on-dark">
  <img src={`${base}/flower.png`} alt="" aria-hidden="true" class="pq-flower" />
  <div class="container pq-inner">
    <span class="section-label animate-in" data-i18n="whynow.quote.label">Our promise</span>
    <blockquote class="animate-in" style="--reveal-delay:0.1s">
      <p class="pq-text" data-i18n="whynow.quote.text">People should come before power.</p>
      <footer class="pq-cite" data-i18n="whynow.quote.cite">Cassandra Echeverria, candidate for Ward 6 Alderperson</footer>
    </blockquote>
  </div>
</section>

<style>
  .pq { position: relative; overflow: hidden; background: var(--purple-deep); padding: var(--space-4xl) 0; text-align: center; }
  .pq-flower { position: absolute; left: 50%; top: 50%; width: 420px; transform: translate(-50%, -50%); opacity: 0.07; pointer-events: none; }
  .pq-inner { position: relative; }
  .pq-text { font-family: var(--font-display); font-weight: 700; font-style: italic; font-size: var(--text-5xl); line-height: 1.08; color: var(--white); max-width: 18ch; margin: 0 auto var(--space-lg); }
  .pq-cite { font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pink); }
</style>
